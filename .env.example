# Generic public-safe environment template.
# Copy to .env and customize locally. Never commit .env or real secrets.

# Paths
PROJECT_ROOT={PROJECT_ROOT}
WORKSPACE_ROOT={WORKSPACE_ROOT}
TARGET_REPOSITORY={TARGET_REPOSITORY}
MCP_CONFIG_DIR={MCP_CONFIG_DIR}

# Runtime hints
DEFAULT_PROFILE=readonly-research
LOCAL_MODEL_RUNTIME=ollama
OLLAMA_BASE_URL={OLLAMA_BASE_URL}

# Database endpoints (placeholders — never commit real connection strings)
DATABASE_URL={DATABASE_URL}
POSTGRES_URL={POSTGRES_URL}
MYSQL_URL={MYSQL_URL}

# Optional provider endpoint placeholders (never commit secrets)
PUBLIC_MCP_ENDPOINT=https://example.com/mcp
GITHUB_TOKEN={GITHUB_TOKEN}
