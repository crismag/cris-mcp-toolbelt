# Generic public-safe environment template
# Copy to .env and customize locally.

BASE_PATH={BASE_PATH}
WORKSPACE_ROOT={WORKSPACE_ROOT}
TOOLBELT_HOME={TOOLBELT_HOME}
TARGET_WORKSPACE={TARGET_WORKSPACE}

# Optional runtime hints
DEFAULT_PROFILE=readonly-research
LOCAL_MODEL_RUNTIME=ollama
LOCAL_MODEL=llama3.1

# Optional provider endpoint placeholders (never commit secrets)
PUBLIC_MCP_ENDPOINT=https://example.com/mcp
PUBLIC_MCP_API_KEY=
